VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- AI 작성 도우미 (선택) ---
# BizRouter API 키. 서버(api/ai.ts)에서만 읽으므로 VITE_ 접두사를 붙이면 안 됩니다.
# (붙이면 브라우저 번들에 그대로 노출됩니다)
# 발급: https://bizrouter.ai
BIZROUTER_API_KEY=

# 사용할 모델 (기본값: openai/gpt-5.6-luna)
# BIZROUTER_MODEL=openai/gpt-5.6-luna

# GPT-5 계열 추론 강도. none/minimal/low/medium/high, 'off'면 보내지 않음 (기본값: low)
# BIZROUTER_REASONING_EFFORT=low

# temperature. 기본은 '보내지 않음' — GPT-5 계열 추론 모델은 기본값(1) 외의
# temperature를 거부합니다. 지원하는 모델로 바꿀 때만 지정하세요.
# BIZROUTER_TEMPERATURE=0.7

# --- PDF 도서 저장소: Cloudflare R2 (선택) ---
# PDF 모드를 쓸 때만 필요합니다. 모두 서버(api/r2-upload-url.ts)에서만 읽으므로
# VITE_ 접두사를 붙이면 안 됩니다.
#
# 준비 순서:
#  1) Cloudflare 대시보드 → R2 → 버킷 생성
#  2) 버킷 → Settings → Public access 로 r2.dev 공개 주소 켜기
#     (또는 사용자 지정 도메인 연결)
#  3) 버킷 → Settings → CORS Policy 에 아래를 넣기
#     [{"AllowedOrigins":["https://librospace-three.vercel.app","http://localhost:5173"],
#       "AllowedMethods":["PUT","GET"],"AllowedHeaders":["*"],"MaxAgeSeconds":3600}]
#  4) R2 → Manage API Tokens → Object Read & Write 토큰 발급
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# 2)에서 얻은 공개 주소. 끝에 / 는 붙이지 마세요. 예: https://pub-xxxx.r2.dev
R2_PUBLIC_BASE_URL=
