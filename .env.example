VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# --- AI 작성 도우미 (선택) ---
# BizRouter API 키. 서버(api/ai.ts)에서만 읽으므로 VITE_ 접두사를 붙이면 안 됩니다.
# (붙이면 브라우저 번들에 그대로 노출됩니다)
# 발급: https://bizrouter.ai
BIZROUTER_API_KEY=

# 사용할 모델 (기본값: openai/gpt-5.6-luna)
# BIZROUTER_MODEL=openai/gpt-5.6-luna

# GPT-5 계열 추론 강도. none/minimal/low/medium/high, 'off'면 보내지 않음 (기본값: low)
# BIZROUTER_REASONING_EFFORT=low

# temperature. 기본은 '보내지 않음' — GPT-5 계열 추론 모델은 기본값(1) 외의
# temperature를 거부합니다. 지원하는 모델로 바꿀 때만 지정하세요.
# BIZROUTER_TEMPERATURE=0.7
